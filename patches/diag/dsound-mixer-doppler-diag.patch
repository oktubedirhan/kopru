 	device->playpos += device->pad - pad_bytes;
 	device->playpos %= device->buflen;
 	device->pad = pad_bytes;
+
+	{ /* KOPRU-DIAG: karistirici zamanlamasi, saniyede bir */
+		static LARGE_INTEGER freq, last, win;
+		static DWORD mixes, maxgap_us, minpad = ~0u, under;
+		LARGE_INTEGER now;
+		if (!freq.QuadPart) QueryPerformanceFrequency(&freq);
+		QueryPerformanceCounter(&now);
+		if (last.QuadPart) {
+			DWORD gap = (DWORD)((now.QuadPart - last.QuadPart) * 1000000 / freq.QuadPart);
+			if (gap > maxgap_us) maxgap_us = gap;
+		} else win = now;
+		last = now; mixes++;
+		if (pad_frames < minpad) minpad = pad_frames;
+		if (!pad_frames) under++;
+		if (now.QuadPart - win.QuadPart >= freq.QuadPart) {
+			TRACE_(kopru)("mix/s %lu maxgap %lu us minpad %lu fr (%lu ms) underrun %lu ac_frames %lu frag %lu\n",
+				mixes, maxgap_us, minpad, minpad * 1000 / device->pwfx->nSamplesPerSec, under,
+				device->ac_frames, device->frag_frames);
+			win = now; mixes = 0; maxgap_us = 0; minpad = ~0u; under = 0;
+		}
+	}
 
 	frames = device->ac_frames - pad_frames;
 	if(!frames){
