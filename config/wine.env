# Köprü: CrossOver 26.3 Wine'ı (cx runtime) çalıştırırken kullanılan ortam değişkenleri.
# Tek kaynak: scripts/kwine ve Köprü.app (App/Sources/Kopru/WineEnvFile.swift) bu dosyayı okur.
#
# Biçim:
#   ANAHTAR=değer    her zaman ayarlanır
#   ANAHTAR?=değer   varsayılan; kwine'da dışarıdan verilen değer kazanır (ör. WINEMSYNC=0 scripts/kwine …).
#                    Uygulama dışarıdan gelen değerleri kullanmaz, bu satırları "=" gibi okur.
#   [d3dmetal]       sonraki satırlar yalnızca D3DMetal açıkken (kwine --no-d3dmetal ile kapanır)
#   [all]            sonraki satırlar yine her zaman
# Yer tutucular: ${RUNTIME} = runtime/crossover-26.3, ${GPTK} = gptk/4.0-beta3/redist/lib, ${PREFIX} = prefix klasörü

[all]
WINEPREFIX=${PREFIX}
# Wine'ın hata ayıklama çıktısı; sorun ararken ör. WINEDEBUG=+err scripts/kwine …
WINEDEBUG?=-all
# FreeType/GnuTLS (x86_64) runtime'ın yanındaki lib/deps klasöründen yüklenir.
DYLD_FALLBACK_LIBRARY_PATH=${RUNTIME}/lib/deps:/usr/local/lib:/usr/lib
# DLL ayarları (boş = yükleme):
#   mshtml: Gecko (tarayıcı motoru) indirme penceresini kapat.
#   (mscoree burada yok: .NET programları (ör. Batman AA'nın BmLauncher'ı) Wine Mono ile çalışsın.
#    Mono 10.4.1 runtime'ın share/wine/mono/ klasöründe; wineboot indirme penceresi açmadan oradan kurar.)
#   winemenubuilder.exe: Wine'ın Mac'te menü/kısayol/dosya ilişkilendirmesi oluşturmasını engelle.
#   gameoverlayrenderer(64): Steam'in oyun içi katmanı; oyunun çizimine kanca atıyor, Wine'da sık çöküyor.
WINEDLLOVERRIDES?=mshtml=;winemenubuilder.exe=;gameoverlayrenderer,gameoverlayrenderer64=
# MSync: senkronizasyon (mutex, event…) macOS Mach çekirdek nesneleriyle; wineserver'a gidip gelmekten hızlı.
# wineserver ile tüm süreçlerde aynı olmalı: değiştirmeden önce prefix'in wineserver'ını kapat.
WINEMSYNC?=1
# Rosetta, oyunlara AVX/AVX2 desteğini bildirsin (bazı oyunlar bunu görmezse açılmıyor).
ROSETTA_ADVERTISE_AVX=1
# Steam arayüzünü (CEF) tek süreçte çalıştır; yoksa pencere siyah kalıyor.
# patches/crossover-26.3/0003: bu değer yalnızca steamwebhelper.exe ana sürecine eklenir.
KOPRU_STEAMWEBHELPER_ARGS?=--single-process

[d3dmetal]
# tools/d3dmetal-hook: bu klasörü DLL arama listesinin başına koyar (d3d11/d3d12/dxgi → D3DMetal).
KOPRU_D3DMETAL_DLLPATH=${GPTK}/wine
# CrossOver ntdll'i: D3DMetal'in macOS kütüphanesini erkenden yükler (Rosetta'ya kod bölgesi bildirimi).
CX_APPLEGPTK_LIBD3DSHARED_PATH=${GPTK}/external/libd3dshared.dylib
