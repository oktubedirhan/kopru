#!/bin/zsh
# Köprü: Wine'ı kendi runtime ve prefix klasörlerimizle çalıştırır.
# Kullanım: scripts/kwine [-r cx|stable] [--no-d3dmetal] <prefix-adı> <program> [argümanlar...]
#   -r cx      (varsayılan) kendi derlediğimiz CrossOver 26.3 Wine'ı + D3DMetal 4
#   -r stable  WineHQ wine-stable 11.0 (D3DMetal yok, grafik wined3d ile)
#   --no-d3dmetal  cx'te D3DMetal'i kapatır; DirectX Wine'ın kendi wined3d'siyle çalışır
#   örnek:  scripts/kwine test notepad
#           scripts/kwine -r stable test notepad
# Prefix yoksa Wine onu ilk çalıştırmada kendisi oluşturur.
# Not: bir prefix'i tek bir runtime ile kullan; Wine sürümleri arasında gidip gelmek prefix'i bozabilir.
set -euo pipefail

KOPRU="$HOME/Library/Application Support/Kopru"
runtime=cx
d3dmetal=1

while (( $# )); do
  case $1 in
    -r) runtime=$2; shift 2 ;;
    --no-d3dmetal) d3dmetal=0; shift ;;
    *) break ;;
  esac
done

if (( $# < 2 )); then
  print -u2 "Kullanım: $0 [-r cx|stable] [--no-d3dmetal] <prefix-adı> <program> [argümanlar...]"
  exit 1
fi

case $runtime in
  stable)
    WINE="$KOPRU/runtime/wine-stable-11.0/Contents/Resources/wine/bin/wine"
    ;;
  cx)
    RT="$KOPRU/runtime/crossover-26.3"
    WINE="$RT/bin/wine"
    # FreeType/GnuTLS (x86_64) Wine'ın yanındaki lib/deps klasöründen yüklenir.
    export DYLD_FALLBACK_LIBRARY_PATH="$RT/lib/deps:/usr/local/lib:/usr/lib"
    if (( d3dmetal )); then
      GPTK="$KOPRU/gptk/4.0-beta3/redist/lib"
      # tools/d3dmetal-hook: bu klasörü DLL arama listesinin başına koyar (d3d11/d3d12/dxgi → D3DMetal).
      export KOPRU_D3DMETAL_DLLPATH="$GPTK/wine"
      # CrossOver ntdll'i: D3DMetal'in macOS kütüphanesini erkenden yükler (Rosetta'ya kod bölgesi bildirimi).
      export CX_APPLEGPTK_LIBD3DSHARED_PATH="$GPTK/external/libd3dshared.dylib"
    fi
    ;;
  *)
    print -u2 "Bilinmeyen runtime: $runtime (cx ya da stable)"
    exit 1
    ;;
esac

export WINEPREFIX="$KOPRU/prefixes/$1"; shift
# DLL ayarları (boş = yükleme):
#   mscoree,mshtml: Mono (.NET) ve Gecko (tarayıcı motoru) indirme pencerelerini kapat.
#   winemenubuilder.exe: Wine'ın Mac'te menü/kısayol/dosya ilişkilendirmesi oluşturmasını engelle.
#   gameoverlayrenderer(64): Steam'in oyun içi katmanı; oyunun çizimine kanca atıyor, Wine'da sık çöküyor.
export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-mscoree,mshtml=;winemenubuilder.exe=;gameoverlayrenderer,gameoverlayrenderer64=}"
if [[ $runtime == cx ]]; then
  # MSync: senkronizasyon (mutex, event…) macOS Mach çekirdek nesneleriyle; wineserver'a gidip gelmekten hızlı.
  # wineserver ile tüm süreçlerde aynı olmalı: değiştirmeden önce prefix'in wineserver'ını kapat.
  # Kapatmak için: WINEMSYNC=0 scripts/kwine ...
  export WINEMSYNC="${WINEMSYNC:-1}"
  # Rosetta, oyunlara AVX/AVX2 desteğini bildirsin (bazı oyunlar bunu görmezse açılmıyor).
  export ROSETTA_ADVERTISE_AVX=1
  # Steam arayüzünü (CEF) tek süreçte çalıştır; yoksa pencere siyah kalıyor.
  # patches/crossover-26.3/0003: bu değer yalnızca steamwebhelper.exe ana sürecine eklenir.
  export KOPRU_STEAMWEBHELPER_ARGS="${KOPRU_STEAMWEBHELPER_ARGS---single-process}"
fi
# Wine'ın hata ayıklama çıktısını sustur; sorun ararken WINEDEBUG=+err gibi açılabilir.
export WINEDEBUG="${WINEDEBUG:--all}"

exec "$WINE" "$@"
