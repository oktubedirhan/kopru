#!/bin/zsh
# Köprü: Wine'ı kendi runtime ve prefix klasörlerimizle çalıştırır.
# Kullanım: scripts/kwine [-r cx|stable] [--no-d3dmetal] <prefix-adı> <program> [argümanlar...]
#   -r cx      (varsayılan) kendi derlediğimiz CrossOver 26.3 Wine'ı + D3DMetal 4
#   -r stable  WineHQ wine-stable 11.0 (D3DMetal yok, grafik wined3d ile)
#   --no-d3dmetal  cx'te D3DMetal'i kapatır; DirectX Wine'ın kendi wined3d'siyle çalışır
#   örnek:  scripts/kwine test notepad
#           scripts/kwine -r stable test notepad
# Prefix yoksa Wine onu ilk çalıştırmada kendisi oluşturur.
# Not: bir prefix'i tek bir runtime ile kullan; Wine sürümleri arasında gidip gelmek prefix'i bozabilir.
set -euo pipefail

KOPRU="$HOME/Library/Application Support/Kopru"
ENVFILE="${0:A:h:h}/config/wine.env"   # cx ortam değişkenleri (Köprü.app ile ortak)
runtime=cx
d3dmetal=1

while (( $# )); do
  case $1 in
    -r) runtime=$2; shift 2 ;;
    --no-d3dmetal) d3dmetal=0; shift ;;
    *) break ;;
  esac
done

if (( $# < 2 )); then
  print -u2 "Kullanım: $0 [-r cx|stable] [--no-d3dmetal] <prefix-adı> <program> [argümanlar...]"
  exit 1
fi

PREFIX="$KOPRU/prefixes/$1"; shift

case $runtime in
  stable)
    WINE="$KOPRU/runtime/wine-stable-11.0/Contents/Resources/wine/bin/wine"
    export WINEPREFIX="$PREFIX"
    export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:-mscoree,mshtml=;winemenubuilder.exe=;gameoverlayrenderer,gameoverlayrenderer64=}"
    export WINEDEBUG="${WINEDEBUG:--all}"
    ;;
  cx)
    RT="$KOPRU/runtime/crossover-26.3"
    GPTK="$KOPRU/gptk/4.0-beta3/redist/lib"
    WINE="$RT/bin/wine"
    # config/wine.env'i oku (biçim dosyanın başında açıklanıyor).
    section=all
    while IFS= read -r line; do
      [[ -z $line || $line == \#* ]] && continue
      if [[ $line == \[*\] ]]; then section=${line:1:-1}; continue; fi
      [[ $section == d3dmetal ]] && (( ! d3dmetal )) && continue
      if [[ $line == *'?='* ]]; then key=${line%%\?=*}; value=${line#*\?=}; optional=1
      else key=${line%%=*}; value=${line#*=}; optional=0; fi
      value=${value//\$\{RUNTIME\}/$RT}
      value=${value//\$\{GPTK\}/$GPTK}
      value=${value//\$\{PREFIX\}/$PREFIX}
      # "?=": dışarıdan verilmişse dokunma
      (( optional )) && [[ -n ${(P)key-} ]] && continue
      export "$key=$value"
    done < "$ENVFILE"
    ;;
  *)
    print -u2 "Bilinmeyen runtime: $runtime (cx ya da stable)"
    exit 1
    ;;
esac

exec "$WINE" "$@"
